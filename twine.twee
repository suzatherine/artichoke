:: scribble [nobr]
<div class="scribble-window" aria-label="Animated scribble">
    <svg class="scribble-svg"
         viewBox="0 0 800 450"
         preserveAspectRatio="none"
         xmlns="http://www.w3.org/2000/svg">

        <rect width="800" height="450" class="scribble-bg"/>

        <g class="scribble-lines">
            <path d="M-50,120 C100,20 180,250 300,120 S500,20 850,180"/>
            <path d="M-50,300 C100,180 220,400 350,250 S600,120 850,300"/>
            <path d="M-50,220 C120,350 220,80 400,220 S650,380 850,150"/>
            <path d="M-50,380 C100,280 180,430 320,320 S600,200 850,380"/>
            <path d="M-50,60 C100,180 240,20 380,100 S620,250 850,50"/>
            <path d="M-50,170 C100,300 250,100 420,190 S650,350 850,180"/>
        </g>

    </svg>
</div>

