<</timed>>




:: stage3-tutorial2-b-question [nobr]

<<set _question = $mappingQuestions[$mappingQuestionIndex]>>

<div class="mapping-question">

    <<for _line range _question[$userchoices.language].question>>
        <span><<= _line>></span>
    <</for>>

</div>

:: stage3-tutorial2-b-navigation [nobr]

<div class="mapping-navigation">
<<if $mappingQuestionIndex > 0>>

    <<button "Back">>

        <<set $mappingQuestionIndex-->>

        <<replace "#videoWrapper">>
            <<include "stage3-tutorial2-b-question">>
        <</replace>>

        <<append "#videoWrapper">>
            <<include "stage3-tutorial2-b-navigation">>
        <</append>>

    <</button>>

<</if>>

<span class="mapping-progress">
    <<= $mappingQuestionIndex + 1>> / <<= $mappingQuestions.length>>
</span>

<<if $mappingQuestionIndex < $mappingQuestions.length - 1>>

    <<button "Next">>

        <<set $mappingQuestionIndex++>>
        <<mappingShowQuestion true>>

    <</button>>

<<else>>


        <<replace "#chatInputWrapper">>
        <</replace>>

        <<timed 5s>>

            <<replace "#chatHistory">>

                <div class="message-received">
                    <span>When ready for the second part, message me <span class="codeword-text">MAPPED</span>.</span>
                </div>

            <</replace>>

        <</timed>>

        <<timed 7s>>

            <<replace "#chatInputWrapper">>
                /* $codewordsStage3.codeword2 */
                <<include "codeword-chat">>
            <</replace>>

        <</timed>>

<</if>>
</div>



