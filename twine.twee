setup.chooseStoryAudio = () => {
  const storyAudioNeeded = State.variables.storyAudioNeeded;
  const storyMonsterNeeded = State.variables.storyMonsterNeeded;
  const audio = document.getElementById("audioPlayer");
    console.log("audio", audio)
  if (!audio) {
    console.error("Audio element with ID 'audioPlayer' not found.");
    return;
  }

  // Remove any previously attached 'ended' event to avoid duplicates
  audio.replaceWith(audio.cloneNode(true));
  const freshAudio = document.getElementById("audioPlayer");

  // Build audio file paths based on storyAudioNeeded numbers
  const audioFiles = storyAudioNeeded.map(num => 
    `assets/voiceover/strongertogethervo_7_${storyMonsterNeeded}_2_S${num}.mp3`
  );

  let currentTrack = 0;

  function playNext() {
    if (currentTrack < audioFiles.length) {
      freshAudio.src = audioFiles[currentTrack];
      freshAudio.play().catch(err => {
        console.error("Audio play failed:", err);
      });
      currentTrack++;
    }
  }

  freshAudio.addEventListener("ended", playNext);

  // Start playback
  playNext();
};

// add placeholder text to input 

setup.addPlaceholder = () => {

    const textbox = document.getElementById("textbox-codeword");
    if (textbox) {
        console.log("Found textbox:", textbox);
        textbox.setAttribute("placeholder", "Type here");
    }
} 

// LOCAL Storage Tutorial Progress

setup.tutorialStorageKey = `artichoke-tutorial-progress-${setup.buildID}`;

// *
//  * Load tutorial progress from localStorage.
//  *
//  * Returns an array such as:
//  * [1, 2]
//  *
//  * If nothing has been saved, or the stored data is invalid,
//  * return an empty array.
//  */
setup.loadTutorialProgress = () => {
    console.log("setup.tutorialStorageKey", setup.tutorialStorageKey)
    console.log("setup.buildID", setup.buildID)
    const saved = localStorage.getItem(setup.tutorialStorageKey);

    if (!saved) {
        return [];
    }

    try {
        const progress = JSON.parse(saved);

        return Array.isArray(progress) ? progress : [];
    } catch (error) {
        console.warn("Could not load tutorial progress:", error);
        return [];
    }
};


/*
 * Save tutorial progress to localStorage.
 */
setup.saveTutorialProgress = (tutorialProgress) => {
    localStorage.setItem(
        setup.tutorialStorageKey,
        JSON.stringify(tutorialProgress)
    );
};


/*
 * Mark a tutorial as complete.
 *
 * The Set prevents duplicates.
 *
 * Example:
 * [1, 2] + 2 → [1, 2]
 * [1, 2] + 3 → [1, 2, 3]
 */
setup.completeTutorial = (tutorialID) => {
    const progress = State.variables.userchoices.tutorialProgress;

    if (!progress.includes(tutorialID)) {
        progress.push(tutorialID);
    }

    setup.saveTutorialProgress(progress);
};


/*
 * Check whether a tutorial has been completed.
 */
setup.isTutorialComplete = (tutorialID) => {
    return State.variables.userchoices.tutorialProgress.includes(tutorialID);
};


setup.clearTutorialProgress = () => {
    localStorage.setItem(
        setup.tutorialStorageKey,
        []
    );
};

// SCROLL INTO VIEW 

setup.scrollIntoView = (id) => {
  const container = document.getElementById(id);
  if (!container) return;

  container.scrollTo({
    top: container.scrollHeight,
    behavior: "smooth"
  });
};

/* Start bubble animation by injecting bubble elements into #bubbles */
setup.startBubbles = () => {

        const container = document.getElementById('bubbles');
        if (!container) return;
        // clear any existing bubbles
        container.innerHTML = '';
        const count = 36;
        for (let i = 0; i < count; i++) {
       
                const b = document.createElement('div');
                b.className = 'bubble';
                const size = Math.round(Math.random() * 60 + 20);
                b.style.width = size + 'px';
                b.style.height = size + 'px';
                b.style.left = Math.random() * 100 + '%';
                b.style.animationDuration = (Math.random() * 6 + 6).toFixed(2) + 's';
                b.style.animationDelay = (Math.random() * 4).toFixed(2) + 's';
                b.style.opacity = (Math.random() * 0.6 + 0.25).toFixed(2);
                container.appendChild(b);
        }
};

setup.dreamJarDrag = () => {

    const jar = document.getElementById("dream-jar");
    const jarImage = document.getElementById("dream-jar-image");
    const message = document.getElementById("dream-jar-message");

    if (!jar || !jarImage) {
        return;
    }

    const labels = [
        document.getElementById("dream-label-one"),
        document.getElementById("dream-label-two"),
        document.getElementById("dream-label-three")
    ];

    let completed = new Set();

    /*
     * Make each label draggable.
     */
    labels.forEach((label) => {

        if (!label) {
            return;
        }

        let dragging = false;
        let offsetX = 0;
        let offsetY = 0;

        /*
         * Start dragging
         */
        label.addEventListener("pointerdown", (e) => {

            // Don't allow a correctly placed label to be moved again
            if (label.classList.contains("placed")) {
                return;
            }

            e.preventDefault();

            dragging = true;

            const labelRect = label.getBoundingClientRect();

            offsetX = e.clientX - labelRect.left;
            offsetY = e.clientY - labelRect.top;

            label.classList.add("dragging");

            // Keep receiving pointer events even if the pointer moves
            // outside the label.
            label.setPointerCapture(e.pointerId);
        });


        /*
         * Move the label
         */
        label.addEventListener("pointermove", (e) => {

            if (!dragging) {
                return;
            }

            e.preventDefault();

            const jarRect = jar.getBoundingClientRect();

            let x = e.clientX - jarRect.left - offsetX;
            let y = e.clientY - jarRect.top - offsetY;

            label.style.left = `${x}px`;
            label.style.top = `${y}px`;
        });


        /*
         * Finish dragging
         */
        label.addEventListener("pointerup", (e) => {

            if (!dragging) {
                return;
            }

            dragging = false;

            label.classList.remove("dragging");

            try {
                label.releasePointerCapture(e.pointerId);
            } catch (error) {
                // Pointer capture may already have been released.
            }

            checkDrop(label);
        });


        /*
         * Also handle the pointer being cancelled
         */
        label.addEventListener("pointercancel", () => {

            if (!dragging) {
                return;
            }

            dragging = false;

            label.classList.remove("dragging");

            checkDrop(label);
        });

    });


    /*
     * Check whether a label has been dropped onto the jar.
     */
    function checkDrop(label) {

        const labelRect = label.getBoundingClientRect();
        const jarRect = jarImage.getBoundingClientRect();

        /*
         * Find the centre point of the label.
         */
        const labelCentreX =
            labelRect.left + (labelRect.width / 2);

        const labelCentreY =
            labelRect.top + (labelRect.height / 2);

        /*
         * The label counts as being on the jar when its centre
         * is inside the jar image.
         */
        const insideJar =
            labelCentreX >= jarRect.left &&
            labelCentreX <= jarRect.right &&
            labelCentreY >= jarRect.top &&
            labelCentreY <= jarRect.bottom;


        if (insideJar) {

            placeLabel(label);

        } else {

            /*
             * If the label wasn't dropped on the jar,
             * return it to its original position.
             */
            label.classList.remove("placed");

            label.style.left = "";
            label.style.top = "";

        }
    }


    /*
     * Lock a label onto the jar.
     */
    function placeLabel(label) {

        if (label.classList.contains("placed")) {
            return;
        }

        label.classList.add("placed");

        /*
         * Record that this label has been successfully placed.
         */
        completed.add(label.id);

        /*
         * Put the label roughly in the centre of the jar.
         *
         * Each label gets a slightly different position so they
         * don't all sit directly on top of one another.
         */
        const positions = {
            "dream-label-one": {
                left: "57%",
                top: "36%"
            },

            "dream-label-two": {
                left: "50%",
                top: "50%"
            },

            "dream-label-three": {
                left: "44%",
                top: "68%"
            }
        };

        const position = positions[label.id];

        if (position) {
            label.style.left = position.left;
            label.style.top = position.top;
        }


        /*
         * Check whether all labels have been placed.
         */
        checkComplete();
    }


    /*
     * Check whether the player has completed the activity.
     */
    function checkComplete() {

        if (completed.size === labels.length) {

            message.textContent = "Well done!";

            message.classList.add("show");

        } else {

            message.textContent = "";
            message.classList.remove("show");
        }
    }
};

