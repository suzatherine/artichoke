/* WIDGETS  */
:: widgets [widget nobr]
<<widget "voicenote">>
    <<set _soundFile to _args[0]>>
    <<set _transcriptDelay to _args[1]>>
    <<set _transcriptPassage to _args[2]>>
    <<set _triggeredPassage to _args[3]>>
  <<audio "ping" "play">>
    <<append "#chatHistory">>
 <div class="voicenote">
<audio preload="auto"><source sc-eval:src=_soundFile></audio>
<button type="button" class="voicenote-toggle" aria-label="Play voice note">
<svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
<svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h4v14H6zM14 5h4v14h-4z" fill="currentColor"/></svg>
</button>
<span class="voicenote-status">Voice note </span>
</div>
<div class="voicenote-transcript-link"></div>
    <</append>>
    <<run setup.initVoicenote(_transcriptDelay, _transcriptPassage, _triggeredPassage)>>
<</widget>>>>

<<widget "mappingShowQuestion">>
    /* _args[0]: true to clear the chat history before showing messages */
    <<set _idx to $mappingQuestionIndex>>
    <<set _msgs to $mappingQuestions[_idx][$userchoices.language].message>>
    <<if _msgs is null or $mappingMessagesShown.includes(_idx)>>
        <<set _msgs to []>>
    <<elseif typeof _msgs is "string">>
        <<set _msgs to [_msgs]>>
    <</if>>
    <<if _msgs.length > 0>>
        <<run $mappingMessagesShown.push(_idx)>>
        <<replace "#videoWrapper">><</replace>>
        <<if _args[0]>>
            <<replace "#chatHistory">><</replace>>
        <</if>>
    <</if>>
    <<for _i, _m range _msgs>>
        <<if _i is 0>>
            <<append "#chatHistory">>
                <div class="message-received"><span><<= _m>></span></div>
            <</append>>
        <<else>>
            <<timed `(_i * 3) + "s"`>>
                <<append "#chatHistory">>
                    <div class="message-received"><span><<= _m>></span></div>
                <</append>>
            <</timed>>
        <</if>>
    <</for>>
    <<if _msgs.length is 0>>
       
            <<replace "#videoWrapper">>
                <<include "stage3-tutorial2-b-question">>
            <</replace>>
   
        <<timed 2s>>
        <<append "#videoWrapper">>
            <<include "stage3-tutorial2-b-navigation">>
        <</append>>
        <</timed>>
    <<else>>
        <<timed `(_msgs.length * 3) + "s"`>>
           
                <<replace "#videoWrapper">>
                    <<include "stage3-tutorial2-b-question">>
                <</replace>>
      
            <<timed 2s>>
            <<append "#videoWrapper">>
                <<include "stage3-tutorial2-b-navigation">>
            <</append>>
            <</timed>>
        <</timed>>
    <</if>>
<</widget>>

<<widget "pictureMessage">>
    <<set _imgFile to _args[0]>>
  <<audio "ping" "play">>
    <<append "#chatHistory">>
 <div class="picture-message">
       <img sc-eval:src=_imgFile>
        </div>
    <</append>>
 <<run setup.scrollIntoView("chatHistory")>>
<</widget>>>>


