:: choose-messages-language [nobr]
/* This is for passages where the content DOESN'T change depending on KS choice */
<<if $userchoices.language is "eng">>
    <<set $messagesToShow to $passage + "-messages-eng">>
<<elseif $userchoices.language is "cym">>
    <<set $messagesToShow to $passage + "-messages-cym">>
<</if>>
<<timed 1s>>
<<include $messagesToShow>>
<</timed>>

:: choose-messages-language-ks-specific [nobr]

/* This is for passages where the content DOES change depending on KS choice */
<<if $userchoices.language is "eng" && $userchoices.keyStage is 1>>
    <<set $messagesToShow to $passage + "-messages-eng-ks1">>
<<elseif $userchoices.language is "eng" && $userchoices.keyStage is 2>>
    <<set $messagesToShow to $passage + "-messages-eng-ks2">>
<<elseif $userchoices.language is "cym" && $userchoices.keyStage is 1>>
    <<set $messagesToShow to $passage + "-messages-cym-ks1">>
<<elseif $userchoices.language is "cym" && $userchoices.keyStage is 2>>
    <<set $messagesToShow to $passage + "-messages-cym-ks2">>
<</if>>
<<timed 1s>>
<<include $messagesToShow>>
<</timed>>

