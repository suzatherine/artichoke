$('#ui-bar').remove();
$(document.head).find('#style-ui-bar').remove();

// Change this for each compiled version.
// Examples:
//   ks1-eng
//   ks2-eng
//   ks1-cym
//   ks2-cym

setup.buildID = "ks1-eng";

// Glowing map spots. Coordinates are pixels on the 300x512 uk-map.jpg.
setup.mapSpotPoints = [
	[130,150],[110,175],[150,185],[120,210],[170,215],[95,230],[140,235],[160,160],[180,200],[100,155],
	[150,260],[185,265],[205,280],[165,285],[215,300],[190,310],[220,320],
	[110,330],[130,355],[100,375],[95,400],[140,375],
	[170,330],[190,345],[165,365],[205,360],[185,385],[220,375],[245,355],[260,365],
	[150,410],[130,425],[110,440],[100,455],[80,465],[175,400],[210,405],
	[235,400],[250,390],[200,415],[170,425],
	[60,270],[30,290],[45,320],[25,350]
];

setup.animateMapSpots = function (wrapperId, intervalMs) {
	intervalMs = intervalMs || 120;
	var points = setup.mapSpotPoints.slice();
	for (var i = points.length - 1; i > 0; i--) {
		var j = Math.floor(Math.random() * (i + 1));
		var t = points[i]; points[i] = points[j]; points[j] = t;
	}
	// Wait for the include to be inserted into the DOM.
	setTimeout(function () {
		var wrapper = document.getElementById(wrapperId);
		if (!wrapper) return;
		points.forEach(function (pt, n) {
			setTimeout(function () {
				var spot = document.createElement('span');
				spot.className = 'map-spot';
				spot.style.left = (pt[0] / 300 * 100) + '%';
				spot.style.top = (pt[1] / 512 * 100) + '%';
				wrapper.appendChild(spot);
			}, n * intervalMs);
		});
	}, 100);
};


