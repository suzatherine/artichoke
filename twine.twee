:: stage3-tutorial2-a-messages-eng [nobr]

<<timed 1s>>
    <<append "#chatHistory">>
         <div class="message-received">
        <span>Before we can imagine something - we need to start from what we know. </span>
        </div>
        <</append>>
    <</timed>>

<<timed 5s>>
    <<append "#chatHistory">>
         <div class="message-received">
        <span>And you are experts in your area. </span>
        </div>
        <</append>>
    <</timed>>

<<timed 8s>>
    <<append "#chatHistory">>
         <div class="message-received">
        <span>More than me</span>
        </div>
        <</append>>
    <</timed>>

<<timed 10s>>
