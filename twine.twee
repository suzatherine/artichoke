:: dreamJar[nobr]
<div id="dream-jar-container">

    <div id="dream-jar">
        <img id="dream-jar-image"
             src="assets/img/jar.png"
             alt="Dream jar">

        <div id="dream-label-one"
             class="dream-jar-label label-one"
             draggable="false">
            Dreaming I’m flying like a bird 
        </div>

        <div id="dream-label-two"
             class="dream-jar-label label-two"
             draggable="false">
           Dreaming what Lionel would look like if he was a Turtle
        </div>

        <div id="dream-label-three"
             class="dream-jar-label label-three"
             draggable="false">
          Dreaming of doing a cartwheel
        </div>
    </div>

    <div id="dream-jar-message"></div>

</div>
<<done>> <<run setup.dreamJarDrag()>>
    <</done>>

