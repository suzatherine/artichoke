        <span>Discuss what you want to put forward as your dream to the BFG and then when ready send me the word BOOK</span>
        </div>
        <</append>>
    <</timed>>


<<timed 5s>>
    <<append "#chatInputWrapper">>
      /* $codewordsStage3.codeword10 */
