/* TEMPLATES */

:: _templateCodeword [nobr]
<<set $codeword to "">>  /* ensure it's blank so the placeholder shows */

<div class="codeinput">
    <<textbox "$codeword" "">>

    <div class="input-btn">
    <<button "Enter">>
        <<set $codeword to $codeword.toUpperCase().trim()>>

        /* Correct */
        <<if $codeword is $correctCodeword>>
            <<replace "#coderesult">><span>Confirmed!</span>
                <<audio "success" play>>
            <</replace>>
     
            <<timed 3s>><<goto $nextpass>><</timed>>
        <<elseif $codeword isnot "">>
            /* Incorrect (non-empty) */
            <<replace "#coderesult">><span class="incorrect-label">Try again.</span><</replace>>
            <<timed 1.5s>><<replace "#coderesult">><</replace>><</timed>>
        <</if>>
