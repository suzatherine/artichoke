:: stage3-tutorial3-b-question [nobr]

<<set _question = $futureFeetQuestions[$futureFeetQuestionIndex]>>

<div class="mapping-question">

    <<if $userchoices.language is "eng">>

        <span><<= _question.eng.question>></span>

    <<elseif $userchoices.language is "cym">>

        <span><<= _question.cym.question>></span>

    <</if>>

</div>

:: stage3-tutorial3-b-navigation [nobr]

        <div class="mapping-navigation">
<<if $futureFeetQuestionIndex > 0>>

    <<button "Back">>

        <<set $futureFeetQuestionIndex-->>

        <<replace "#videoWrapper">>
            <<include "stage3-tutorial3-b-question">>
        <</replace>>

        <<append "#videoWrapper">>
            <<include "stage3-tutorial3-b-navigation">>
        <</append>>

    <</button>>

<</if>>

<span class="mapping-progress">
    <<= $futureFeetQuestionIndex + 1>> / <<= $futureFeetQuestions.length>>
</span>

<<if $futureFeetQuestionIndex < $futureFeetQuestions.length - 1>>

    <<button "Next">>

        <<set $futureFeetQuestionIndex ++>>
        <<replace "#chatHistory">>
        <</replace>>
        <<set _next = $futureFeetQuestions[$futureFeetQuestionIndex][$userchoices.language]>>
        <<if _next.message and !$futureFeetMessagesShown.includes($futureFeetQuestionIndex)>>
            <<run $futureFeetMessagesShown.push($futureFeetQuestionIndex)>>
            <<append "#chatHistory">>
                <div class="message-received">
                    <span><<= _next.message>></span>
                </div>
            <</append>>
        <</if>>

        <<replace "#videoWrapper">>
            <<include "stage3-tutorial3-b-question">>
        <</replace>>

        <<append "#videoWrapper">>
            <<include "stage3-tutorial3-b-navigation">>
        <</append>>

    <</button>>

<<else>>

        <<replace "#chatInputWrapper">>
        <</replace>>
        <<timed 5s>>
            <<replace "#chatInputWrapper">>
      <<button "Next">>
          <<goto $nextPassage>>
      <</button>>
    <</replace>>

        <</timed>>

<</if>>
</div>

