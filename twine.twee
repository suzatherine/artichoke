        <span>So - what is there? </span>
        </div>
        <</append>>
    <</timed>>

<<timed 13s>>
    <<append "#chatHistory">>
         <div class="message-received">
        <span>Decide how you want to map and then I’ll send you some prompts. 
        <br/>
Teacher, I’ve sent you some thoughts on how you could map the area.
</span>
        </div>
        <</append>>
    <</timed>>

<<timed 15s>>
    <<replace "#chatInputWrapper">>
        <div class="btn-option-wrapper">
            <<include "nextBtn">>
        </div>
    <</replace>>
<</timed>>



