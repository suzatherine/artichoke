:: stage3-tutorial2-d-messages-eng [nobr]

<<timed 1s>>
    <<append "#chatHistory">>
         <div class="message-received">
        <span>I want you to have 5 minutes to daydream about this place, and to dream about what it could be.
        <br/>
        You’ll scribble on your page about this question.</span>
        </div>
        <</append>>
    <</timed>>

/* PUT QUESTION INTO EXERCISE AREA  */
<<timed 7s>>
    <<replace "#videoWrapper">>
         <div class="mapping-question">
        <span>What could be added or changed in this place to make everyone in it happier? </span>
        </div>
        <</replace>>
    <</timed>>

<<timed 12s>>
    <<append "#chatHistory">>
         <div class="message-received">
        <span>When you are ready to Daydream click</span>
        </div>
        <</append>>
    <</timed>>


<<timed 13s>>
    <<append "#chatInputWrapper">>
     <<button "Daydream">>
        <<replace "#chatHistory">><</replace>>
        <<replace "#chatInputWrapper">><</replace>>
        <<replace "#videoWrapper">>
            <<include "scribble">>
            <<run setup.startScribbleTimer()>>
        <</replace>>

        <<timed 5s>>
        <<append "#chatHistory">>
            <div class="message-received">
            <span>If you want another 5 minutes just click to SCRIBBLE or you can MOVE ON</span>
            </div>
            <</append>>
        <<append "#chatInputWrapper">>
       <<timed 2s>>
            <<button "SCRIBBLE">>
                <<replace "#videoWrapper">>
                <<include "scribble">>
                   <<run setup.startScribbleTimer()>>
                   <</replace>>
                   <<timed 300s>>
                       <<goto $nextPassage>>
                    <</timed>>
                <</button>>
            <<button "MOVE ON">>
                <<goto $nextPassage>>
                    <</button>>
         <</timed>>
         <</append>>
         <</timed>>
    
            <</button>>
             <</append>>

    <</timed>>
