setup.chooseStoryAudio = () => {
  const storyAudioNeeded = State.variables.storyAudioNeeded;
  const storyMonsterNeeded = State.variables.storyMonsterNeeded;
  const audio = document.getElementById("audioPlayer");
    console.log("audio", audio)
  if (!audio) {
    console.error("Audio element with ID 'audioPlayer' not found.");
    return;
  }

  // Remove any previously attached 'ended' event to avoid duplicates
  audio.replaceWith(audio.cloneNode(true));
  const freshAudio = document.getElementById("audioPlayer");

  // Build audio file paths based on storyAudioNeeded numbers
  const audioFiles = storyAudioNeeded.map(num => 
    `assets/voiceover/strongertogethervo_7_${storyMonsterNeeded}_2_S${num}.mp3`
  );

  let currentTrack = 0;

  function playNext() {
    if (currentTrack < audioFiles.length) {
      freshAudio.src = audioFiles[currentTrack];
      freshAudio.play().catch(err => {
        console.error("Audio play failed:", err);
      });
      currentTrack++;
    }
  }

  freshAudio.addEventListener("ended", playNext);

  // Start playback
  playNext();
};

// Wires up the most recently added voice note (see the "voicenote" widget):
// a play/pause toggle on an HTML audio element.
setup.initVoicenote = (transcriptDelay, transcriptPassage, triggeredPassage) => {
  const $vn = $("#chatHistory > .voicenote").last();
  const $transcriptLink = $vn.next(".voicenote-transcript-link");
  const audio = $vn.find("audio")[0];
  const $button = $vn.find(".voicenote-toggle");
  const $status = $vn.find(".voicenote-status");
  if (!audio) return;

  const delay = Util.fromCssTime(transcriptDelay || "3s");
  const include = (passage) => `<<include ${JSON.stringify(passage)}>>`;
  let started = false;

  const setState = (playing, statusHtml) => {
    $vn.toggleClass("is-playing", playing);
    $button.attr("aria-label", playing ? "Pause voice note" : "Play voice note");
    $status.html(statusHtml);
  };

  const showTranscriptLink = () => {
    if (!document.body.contains($vn[0]) || !transcriptPassage) return;
    $("<a class='link-internal' role='button' tabindex='0'>Show Transcript</a>")
      .on("click keydown", function (ev) {
        if (ev.type === "keydown" && ev.key !== "Enter" && ev.key !== " ") return;
        ev.preventDefault();
        $transcriptLink.empty();
        $("<div class='transcript'></div>")
          .appendTo("#chatHistory")
          .wiki(include(transcriptPassage));
      })
      .appendTo($transcriptLink);
  };

  const onFirstPlay = () => {
    started = true;
    if (triggeredPassage) {
      $("<span class='voicenote-triggered'></span>")
        .appendTo($vn)
        .wiki(include(triggeredPassage));
    }
    setTimeout(showTranscriptLink, delay);
  };

  $button.on("click", () => {
    if (audio.paused) {
      audio.play().catch(err => console.error("Voice note play failed:", err));
    } else {
      audio.pause();
    }
  });

  audio.addEventListener("play", () => {
    setState(true, "<em>Playing...</em>");
    if (!started) onFirstPlay();
  });
  audio.addEventListener("pause", () => {
    if (!audio.ended) setState(false, "<em>Paused</em>");
  });
  audio.addEventListener("ended", () => setState(false, "Voice note "));
};

// add placeholder text to input 

setup.addPlaceholder = () => {

    const textbox = document.getElementById("textbox-codeword");
    if (textbox) {
       
        textbox.setAttribute("placeholder", "Type here");
    }
} 

// LOCAL Storage Tutorial Progress

setup.tutorialStorageKey = `artichoke-tutorial-progress-${setup.buildID}`;

// *
//  * Load tutorial progress from localStorage.
//  *
//  * Returns an array such as:
//  * [1, 2]
//  *
//  * If nothing has been saved, or the stored data is invalid,
//  * return an empty array.
//  */
setup.loadTutorialProgress = () => {
    console.log("setup.tutorialStorageKey", setup.tutorialStorageKey)
    console.log("setup.buildID", setup.buildID)
    const saved = localStorage.getItem(setup.tutorialStorageKey);

    if (!saved) {
        return [];
    }

    try {
        const progress = JSON.parse(saved);

        return Array.isArray(progress) ? progress : [];
    } catch (error) {
        console.warn("Could not load tutorial progress:", error);
        return [];
    }
};


/*
 * Save tutorial progress to localStorage.
 */
setup.saveTutorialProgress = (tutorialProgress) => {
    localStorage.setItem(
        setup.tutorialStorageKey,
        JSON.stringify(tutorialProgress)
    );
};


/*
 * Mark a tutorial as complete.
 *
 * The Set prevents duplicates.
 *
 * Example:
 * [1, 2] + 2 → [1, 2]
 * [1, 2] + 3 → [1, 2, 3]
 */
setup.completeTutorial = (tutorialID) => {
    const progress = State.variables.userchoices.tutorialProgress;

    if (!progress.includes(tutorialID)) {
        progress.push(tutorialID);
    }

    setup.saveTutorialProgress(progress);
};


/*
 * Check whether a tutorial has been completed.
 */
setup.isTutorialComplete = (tutorialID) => {
    return State.variables.userchoices.tutorialProgress.includes(tutorialID);
};


setup.clearTutorialProgress = () => {
    localStorage.setItem(
        setup.tutorialStorageKey,
        []
    );
};

// SCROLL INTO VIEW 

setup.scrollIntoView = (id) => {
  const container = document.getElementById(id);
  if (!container) return;

  container.scrollTo({
    top: container.scrollHeight,
    behavior: "smooth"
  });
};

// Auto-scroll #chatHistory whenever a message is added, on every passage
setup.chatObserver = null;
$(document).on(':passagedisplay', () => {
  if (setup.chatObserver) {
    setup.chatObserver.disconnect();
    setup.chatObserver = null;
  }
  if (!document.getElementById("scribbleTimer")) {
    setup.stopScribbleTimer();
  }
  const chat = document.getElementById("chatHistory");
  if (!chat) return;
  setup.chatObserver = new MutationObserver(() => setup.scrollIntoView("chatHistory"));
  setup.chatObserver.observe(chat, { childList: true });
});

setup.scribbleTimerInterval = null;
setup.scribbleTimerFrame = null;
setup.stopScribbleTimer = () => {
  if (setup.scribbleTimerInterval !== null) {
    clearInterval(setup.scribbleTimerInterval);
    setup.scribbleTimerInterval = null;
  }
  if (setup.scribbleTimerFrame !== null) {
    cancelAnimationFrame(setup.scribbleTimerFrame);
    setup.scribbleTimerFrame = null;
  }
};

setup.startScribbleTimer = (durationSeconds = 300) => {
  setup.stopScribbleTimer();

  const endTime = Date.now() + durationSeconds * 1000;
  setup.scribbleTimerFrame = requestAnimationFrame(() => {
    setup.scribbleTimerFrame = null;
    const timer = document.getElementById("scribbleTimer");
    if (!timer) {
      console.error("Scribble countdown element with ID 'scribbleTimer' not found.");
      return;
    }

    const updateTimer = () => {
      const secondsRemaining = Math.max(0, Math.ceil((endTime - Date.now()) / 1000));
      const minutes = Math.floor(secondsRemaining / 60);
      const seconds = secondsRemaining % 60;

      timer.textContent = `${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`;
      timer.setAttribute("aria-label", `${minutes} minutes ${seconds} seconds remaining`);

      if (secondsRemaining === 0) {
        setup.stopScribbleTimer();
      }
    };

    updateTimer();
    setup.scribbleTimerInterval = setInterval(updateTimer, 1000);
  });
};

/* Start bubble animation by injecting bubble elements into #bubbles */
setup.startBubbles = () => {

        const container = document.getElementById('bubbles');
        if (!container) return;
        // clear any existing bubbles
        container.innerHTML = '';
        const count = 36;
        for (let i = 0; i < count; i++) {
       
                const b = document.createElement('div');
                b.className = 'bubble';
                const size = Math.round(Math.random() * 60 + 20);
                b.style.width = size + 'px';
                b.style.height = size + 'px';
                b.style.left = Math.random() * 100 + '%';
                b.style.animationDuration = (Math.random() * 6 + 6).toFixed(2) + 's';
                b.style.animationDelay = (Math.random() * 4).toFixed(2) + 's';
                b.style.opacity = (Math.random() * 0.6 + 0.25).toFixed(2);
                container.appendChild(b);
        }
};

setup.dreamJarDrag = () => {

    const container = document.getElementById("dream-jars");
    if (!container) {
        return;
    }

    const jars = Array.from(container.querySelectorAll(".dream-jar-item"));
    const labels = Array.from(document.querySelectorAll(".dream-jar-label"));
    let placedCount = 0;

    labels.forEach((label) => {

        let dragging = false;
        let startX = 0;
        let startY = 0;

        label.addEventListener("pointerdown", (e) => {
            if (label.classList.contains("placed")) {
                return;
            }
            e.preventDefault();
            dragging = true;
            startX = e.clientX;
            startY = e.clientY;
            label.classList.add("dragging");
            label.setPointerCapture(e.pointerId);
        });

        label.addEventListener("pointermove", (e) => {
            if (!dragging) {
                return;
            }
            e.preventDefault();
            label.style.transform =
                `translate(${e.clientX - startX}px, ${e.clientY - startY}px)`;
        });

        const finish = (e) => {
            if (!dragging) {
                return;
            }
            dragging = false;
            label.classList.remove("dragging");
            try {
                label.releasePointerCapture(e.pointerId);
            } catch (error) {
                // Pointer capture may already have been released.
            }
            checkDrop(label);
        };

        label.addEventListener("pointerup", finish);
        label.addEventListener("pointercancel", finish);
    });

    // A label is only accepted by the jar it belongs to.
    function checkDrop(label) {

        const rect = label.getBoundingClientRect();
        const cx = rect.left + rect.width / 2;
        const cy = rect.top + rect.height / 2;

        const targetJar = jars.find((jar) => jar.dataset.jar === label.dataset.jar);
        const jarRect = targetJar.getBoundingClientRect();

        const insideCorrectJar =
            cx >= jarRect.left && cx <= jarRect.right &&
            cy >= jarRect.top && cy <= jarRect.bottom;

        if (insideCorrectJar) {
            placeLabel(label, targetJar);
        } else {
            label.style.transform = "";
            const wrongJar = jars.some((jar) => {
                const r = jar.getBoundingClientRect();
                return cx >= r.left && cx <= r.right && cy >= r.top && cy <= r.bottom;
            });
            if (wrongJar) {
                label.classList.add("wrong");
                setTimeout(() => label.classList.remove("wrong"), 500);
            }
        }
    }

    function placeLabel(label, jar) {
        label.classList.add("placed");
        label.style.transform = "";
        jar.querySelector(".dream-jar-slot").appendChild(label);
        placedCount++;

        if (placedCount === labels.length) {
            setTimeout(() => Engine.play(State.variables.nextPassage), 1200);
        }
    }
};

