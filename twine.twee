    <<replace "#videoWrapper">>
        <<include "stage5-videoChat-video-eng">>
    <</replace>>
    <</timed>>
    <<timed 1s>>
    <<include "stage5-videoChat-messages-eng">>
    <</timed>>
<<elseif $userchoices.language is "cym">>
    <<timed 0.1s>>
    <<replace "#videoWrapper">>
        <<include "stage5-videoChat-video-cym">>
     <</replace>>
     <</timed>>
      <<timed 1s>>
    <<include "stage5-videoChat-messages-eng">>
    <</timed>>
<</if>>




:: stage5-videoChat-video-eng[nobr]
<iframe width='800px' height='450px' 
      src='https://player.vimeo.com/video/938105229?h=afecc81d56&amp;badge=0&amp;autoplay=1&amp;autopause=0&amp;player_id=0&amp;app_id=58479'></iframe>

:: stage5-videoChat-video-cym[nobr]
<iframe width='800px' height='450px' 
      src='https://player.vimeo.com/video/938105229?h=afecc81d56&amp;badge=0&amp;autoplay=1&amp;autopause=0&amp;player_id=0&amp;app_id=58479'></iframe>

:: stage5-videoChat-messages-eng [nobr]
<<timed 0.1s>>
    <<append "#chatHistory">>
         <div class="message-received">
        <span>Stage 5</span>
        </div>
        <</append>>
    <</timed>>

<<timed 2s>>
    <<append "#chatHistory">>
         <div class="message-received">
        <span>Lorem Ipsum English</span>
        </div>
        <</append>>
    <</timed>>

<<timed 4s>>
    <<append "#chatHistory">>
         <div class="message-received">
        <span>Lorem Ipsum English</span>
        </div>
        <</append>>
    <</timed>>

<<timed 6s>>
    <<voicenote "assets/sound/ping1.mp3">>
    <</timed>>

<<timed 8s>>
    <<pictureMessage "assets/img/placeholder.jpeg">>
    <</timed>>

:: stage5-videoChat-messages-cym [nobr]
<<timed 0.1s>>
    <<append "#chatHistory">>
         <div class="message-received">
        <span>Stage 5</span>
        </div>
        <</append>>
    <</timed>>

<<timed 2s>>
    <<append "#chatHistory">>
         <div class="message-received">
        <span>Lorem Ipsum Welsh</span>
        </div>
        <</append>>
    <</timed>>

<<timed 4s>>
    <<append "#chatHistory">>
         <div class="message-received">
        <span>Lorem Ipsum Welsh</span>
        </div>
        <</append>>
    <</timed>>


:: stage5-ending [nobr]
<<set $passage to "stage5-ending">>
<div class="page-wrapper">
    <main class="main-content-center">
        <div class="bubbles-wrapper">
            <div id="bubbles"></div>
            <div class="content">
                <h1>Stage 5</h1>
           
             
            </div>
        </div>
    </main>
</div>
<<include "footer">>

<!-- Bubble CSS moved to styles/styles.css -->
<<done>>
<<run setup.startBubbles()>>
<</done>>

:: video1 [nobr]
<<set $passage to "video1">>
<main>
<p>video 1</p>
<<button "landing">>
    <<goto "landing-ks1-eng">>
    <</button>>
</main>

