:: widgets [widget nobr]
<<widget "voicenote">>
    <<set _soundFile to _args[0]>>
    <<set _transcriptDelay to _args[1]>>
    <<set _transcriptPassage to _args[2]>>
  <<audio "ping" "play">>
    <<append "#chatHistory">>
 <div class="voicenote">
<<link "<img src = 'assets/img/play.png'>" >>
 <<replace "#audio">>
  <audio autoplay>
    <source sc-eval:src=_soundFile>
    </audio>
  <</replace>>
  <<replace "#status">><em>Playing...</em><</replace>>
  <<timed _transcriptDelay>>
        <<append "#chatHistory">>
            <div class="transcript">
                <<include _transcriptPassage>>
            </div>
        <</append>>
    <</timed>>
<</link>> 
<span id="status">Voice note </span></div>
    <</append>>
    
    
<</widget>>>>

