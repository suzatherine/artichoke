:: codeword-landing [nobr]
/* Not using template because there are two options of journey  */
<<set $codeword to "">>  /* ensure it's blank so the placeholder shows */

<div class="codeinput">
  <<textbox "$codeword" "">>

  <div class="input-btn" id="codeword-input-btn">
  <<button "Enter">>

            /* Normalise the user's input */
            <<set $codeword to $codeword.trim().toUpperCase()>>

            /* Reset the destination before searching */
            <<set $nextPassage to "">>

            /* Search every codeword entry */
            <<for _key, _entry range $codewordsLanding>>

                <<if $codeword is _entry[$userchoices.language]>><<set $nextPassage to _entry.destinationPassage>><<break>><</if>>
            <</for>>

            <<if $nextPassage isnot "">>
                 <<replace "#codeword-input-btn">>
                    <<type 70ms>> <span class="correct-label">Correct!</span><</type>>
                    <<audio "success" play>>
                <</replace>>

                <<timed 3s>>
                    <<goto "connecting">>
                <</timed>>

            <<elseif $codeword isnot "">>
                <<replace "#coderesult">>
                    <span>Try again.</span>
                <</replace>>

                <<timed 1.5s>>
                    <<replace "#coderesult">><</replace>>
                <</timed>>

            <</if>>

        <</button>>
  </div>
</div>

<div id="coderesult" class="white"></div>

<<done>><<set $e to setup.addPlaceholder()>><</done>>

:: codeword-security-check [nobr]
/* Not using template because there are two options of journey  */
/* This is the codeword chat input. It will check codewords based on the starting passage. */
<<set $codeword to "">>  /* ensure it's blank so the placeholder shows */

<div class="codeinput">
  <<textbox "$codeword" "">>

  <div class="input-btn" id="codeword-input-btn">
  <<button "Enter">>

            /* Normalise the user's input */
            <<set $codeword to $codeword.trim().toUpperCase()>>

            /* Reset the destination before searching */
            <<set $nextPassage to "">>

            /* Search codewords that start at this passage */
            <<for _key, _entry range $codewordsSecurityCheck>>
                <<if _entry.startingPassage is $passage>>
                    <<if $codeword is _entry[$userchoices.language]>><<set $nextPassage to _entry.destinationPassage>><<break>><</if>>
                <</if>>
            <</for>>

            <<if $nextPassage isnot "">>
                <<replace "#codeword-input-btn">>
                   <<type 70ms>> <span class="correct-label">Correct!</span><</type>>
                    <<audio "success" play>>
                <</replace>>
        /* If we are at the end of the security check, go to connecting, otherwise go to the next passage in the security check. */
                <<timed 3s>>
               <<if passage() is "stage2-securityCheck-c">>
                    <<goto "connecting">>
                <<else>>
                    <<goto $nextPassage>>
                <</if>>
                     <</timed>>

            <<elseif $codeword isnot "">>
                <<replace "#coderesult">>
                    <span>Try again.</span>
                <</replace>>

                <<timed 1.5s>>
                    <<replace "#coderesult">><</replace>>
                <</timed>>

            <</if>>

        <</button>>
  </div>
</div>
<br/>
<div id="coderesult"></div>

<<done>><<set $e to setup.addPlaceholder()>><</done>>

:: codeword-chat [nobr]
/* Not using template because there are two options of journey  */
/* This is the codeword chat input. It will check codewords based on the starting passage. */
<<set $codeword to "">>  /* ensure it's blank so the placeholder shows */

<div class="codeinput">
  <<textbox "$codeword" "">>

  <div class="input-btn" id="codeword-input-btn">
  <<button "Enter">>

            /* Normalise the user's input */
            <<set $codeword to $codeword.trim().toUpperCase()>>

            /* Reset the destination before searching */
            <<set $nextPassage to "">>

            /* Search codewords that start at this passage */
            <<for _key, _entry range $codewords>>
                <<if _entry.startingPassage is $passage>>
                    <<if $codeword is _entry[$userchoices.language]>><<set $nextPassage to _entry.destinationPassage>><<break>><</if>>
                <</if>>
            <</for>>

            <<if $nextPassage isnot "">>
                <<replace "#codeword-input-btn">>
                   <<type 70ms>> <span class="correct-label">Correct!</span><</type>>
                    <<audio "success" play>>
                <</replace>>

                <<timed 3s>>
                    <<goto $nextPassage>>
                <</timed>>

            <<elseif $codeword isnot "">>
                <<replace "#coderesult">>
                    <span>Try again.</span>
                <</replace>>

                <<timed 1.5s>>
                    <<replace "#coderesult">><</replace>>
                <</timed>>

            <</if>>

        <</button>>
  </div>
</div>
<br/>
<div id="coderesult"></div>

<<done>><<set $e to setup.addPlaceholder()>><</done>>


