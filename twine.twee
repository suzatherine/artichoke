<</timed>>
<main class="tutorials-menu">
<h2>PICK A DREAM TEAM VIDEO TO COMPLETE</h2>

<div class="bubble-grid" role="list">
    <div class="bubble-btn one" role="listitem">
        <a class="bubble-link" id="bubble-link-1" data-passage="stage3-tutorial1-video">Tutorial 1
        </a>
<<timed 0.1s>>
    <<if $userchoices.tutorialProgress.includes(1)>>
        <<append "#bubble-link-1">><span>Complete!</span><</append>>
    
            <<addclass ".one" "completed">>
      <div class="bubble-complete">✓</div><</if>>
        <</timed>>
    </div>


    <div class="bubble-btn two" role="listitem">
        <a class="bubble-link" id="bubble-link-2" data-passage="stage3-tutorial2-video">Tutorial 2</a>
        <<timed 0.1s>>
        <<if $userchoices.tutorialProgress.includes(2)>>
                <<append "#bubble-link-2">><span>Complete!</span><</append>>
            <<addclass ".two" "completed">>
        <div class="bubble-complete">✓</div><</if>>
           <</timed>>
    </div>

    <div class="bubble-btn three" role="listitem">
        <a class="bubble-link" id="bubble-link-3" data-passage="stage3-tutorial3-video">Tutorial 3</a>
            <<timed 0.1s>>
        <<if $userchoices.tutorialProgress.includes(3)>>
                <<append "#bubble-link-3">><span>Complete!</span><</append>>    
            <<addclass ".three" "completed">>
        <div class="bubble-complete">✓</div><</if>>
            <</timed>>
    </div>
</div>
<br/>
<div class="tutorial-complete">
    <h3>WHEN READY TO SEND DREAMS TO THE BFG. </h3>
 <div class="tutorial-complete-btns">
     <<button "Send">>
         <<goto "stage3-submission-call-bea">>
            <</button>>
        
      
 </div>
</div>

<div class="tutorial-options">
    <div class="">
        <p>If you want to rewatch my video transmission then click here</p>
        <<button "Rewatch">>
           <<goto "stage3-video">>
        <</button>>
        </div>
    
    
    <div class="clear-progress-container">
        <p>Or if you want to start again...</p>
        <<button "Clear progress">>
            <<set $userchoices.tutorialProgress to []>>
            <<run setup.clearTutorialProgress()>>
            <<goto "stage3-tutorials-menu">>
        <</button>>
        </div>
</div>

</main>
<<include "footer">>

